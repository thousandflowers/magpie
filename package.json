{
  "name": "magpie",
  "version": "0.1.1",
  "private": true,
  "description": "Chrome extension (MV3) that finds every image, video and audio file a page loads or references, explores the app to load the rest, groups them by similarity, and downloads them in bulk. No build step, no runtime dependencies.",
  "keywords": [
    "chrome-extension",
    "manifest-v3",
    "media",
    "downloader",
    "image-downloader",
    "bulk-download",
    "similarity",
    "clustering",
    "hls",
    "dash",
    "har",
    "crawler",
    "lazy-loading"
  ],
  "license": "MIT",
  "author": "Eugenio Zamengo Pontrelli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thousandflowers/magpie.git"
  },
  "bugs": {
    "url": "https://github.com/thousandflowers/magpie/issues"
  },
  "homepage": "https://github.com/thousandflowers/magpie#readme",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\" && node test/browser/service-worker.smoke.mjs && node test/browser/e2e.mjs",
    "test:unit": "node --test \"test/*.test.mjs\"",
    "test:smoke": "node test/browser/service-worker.smoke.mjs",
    "test:e2e": "node test/browser/e2e.mjs",
    "test:dash": "node test/browser/dash-protection.mjs",
    "gallery": "node test/fixtures/gallery-server.mjs",
    "screenshots": "node test/browser/panel-screenshots.mjs"
  }
}
